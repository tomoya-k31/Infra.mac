      "Bash(ansible *)",
      "Bash(ansible-console *)",
      "Bash(ansible-playbook *k3s*)",
      "Bash(ansible-playbook *inventory*)",
      "Bash(ansible-playbook *become*)",
      "Bash(op *)",
      "Bash(*become-password.sh*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(kubectl *)",
      "Bash(kubecolor *)",
      "Bash(helm *)",
